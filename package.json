{
  "name": "@cordisx/chatroom",
  "version": "0.1.0",
  "private": true,
  "description": "Chatroom Room collaboration plugin for CordisX",
  "license": "MIT",
  "type": "module",
  "main": "./dist/chatroom.js",
  "types": "./dist/chatroom.d.ts",
  "files": [
    "dist",
    "entities",
    "cordisx-package.json",
    "runtime-manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-runtime-bundle.mjs && node scripts/copy-build-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "dev": "cordisx dev ./src/chatroom.ts",
    "dev:dry-run": "cordisx dev ./src/chatroom.ts --dry-run"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@cordisx/protocol": "github:cordisx/cordisx-protocol#79fa4ef1b81f0281e8e8c5d0276989b97eb0e41e",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cordisx": "github:cordisx/cordisx#b847ee4391f880a316aad3a26f39b323e4d22b7c",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  }
}
