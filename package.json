{
  "name": "@cordisx/chatroom",
  "version": "0.1.0",
  "private": true,
  "description": "Chatroom Room collaboration plugin for CordisX",
  "license": "MIT",
  "type": "module",
  "main": "./dist/runtime/chatroom.js",
  "types": "./dist/chatroom.d.ts",
  "files": [
    "dist",
    "entities",
    "cordisx-package.json",
    "runtime-manifest.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/clean-build-output.mjs && tsc -p tsconfig.json && vite build --config vite.config.mjs && node scripts/verify-runtime-bundle.mjs && node scripts/copy-build-assets.mjs",
    "check:fast": "npm run lint:staged && npm run typecheck && npm run build && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "dev": "cordisx dev ./src/chatroom.ts",
    "dev:dry-run": "cordisx dev ./src/chatroom.ts --dry-run",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint:source": "eslint .",
    "lint": "eslint .",
    "lint:staged": "lint-staged --config .lintstagedrc.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@cordisx/protocol": "github:cordisx/cordisx-protocol#703a3d03f1b533c4d54bf51e5c8818b53bdda4f5",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@oneworks/avatar": "1.0.0-rc.9",
    "@oneworks/avatar-react": "1.0.0-rc.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cordisx": "github:cordisx/cordisx#998673a98339bcdf6975044ca045f7278981400a",
    "dprint": "0.57.1",
    "esbuild": "^0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.9.2",
    "vite": "8.2.2",
    "@cordisx/eslint-config": "github:cordisx/cordisxmono#c63c2e8c2ba7e11502934a52ad2ce3734e804cdc",
    "eslint": "9.39.4",
    "@typescript-eslint/parser": "8.69.0",
    "lint-staged": "16.2.7"
  }
}
