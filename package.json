{
  "name": "@cordisx/chatroom",
  "version": "0.1.0",
  "private": true,
  "description": "Chatroom Room collaboration plugin for CordisX",
  "license": "MIT",
  "type": "module",
  "main": "./dist/chatroom.js",
  "types": "./dist/chatroom.d.ts",
  "files": [
    "dist",
    "cordisx-package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-build-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "dev": "cordisx dev ./src/chatroom.ts",
    "dev:dry-run": "cordisx dev ./src/chatroom.ts --dry-run"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@cordisx/protocol": "github:cordisx/cordisx-protocol#8891722a7735a3bd00bdd5315084b35b748f5e7f",
    "@deepseek-ai/cordis": "4.0.1",
    "cordisx": "github:cordisx/cordisx#25f8c9b75594ed328cbe5d7a475e119c084276dd",
    "typescript": "^5.9.2"
  }
}
