{
  "name": "@cordisx/chatroom",
  "version": "0.1.0",
  "private": true,
  "description": "Chatroom Room collaboration plugin for CordisX",
  "license": "MIT",
  "type": "module",
  "main": "./dist/runtime/chatroom.js",
  "types": "./dist/chatroom.d.ts",
  "files": [
    "dist",
    "entities",
    "cordisx-package.json",
    "runtime-manifest.json",
    "THIRD_PARTY_NOTICES.md",
    "cordisx-agent-tools.json"
  ],
  "scripts": {
    "build": "node scripts/clean-build-output.mjs && tsc -p tsconfig.json && vite build --config vite.config.mjs && node scripts/verify-runtime-bundle.mjs && node scripts/copy-build-assets.mjs && node scripts/copy-agent-tool-assets.mjs",
    "check:fast": "npm run lint:staged && npm run lint:css && npm run typecheck && npm run build && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.mjs",
    "check": "npm run lint:css && npm run typecheck && npm run build && npm test",
    "dev": "cordisx dev ./src/chatroom.ts",
    "dev:dry-run": "cordisx dev ./src/chatroom.ts --dry-run",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint:source": "eslint .",
    "lint": "eslint .",
    "lint:staged": "lint-staged --config .lintstagedrc.mjs",
    "lint:css": "stylelint \"src/**/*.css\""
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@cordisx/eslint-config": "github:cordisx/cordisxmono#c63c2e8c2ba7e11502934a52ad2ce3734e804cdc",
    "@cordisx/protocol": "github:cordisx/cordisx-protocol#a39c5d1f61999a69043180d6b7e7bbbee3072c09",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@oneworks/avatar": "1.0.0-rc.9",
    "@oneworks/avatar-react": "1.0.0-rc.9",
    "@projectwallace/stylelint-plugin": "0.7.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-react": "6.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cordisx": "github:cordisx/cordisx#e0a7d7b6fbd653dcf55b4105d3d193e49443826f",
    "dprint": "0.57.1",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "lint-staged": "16.2.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "stylelint": "17.15.0",
    "typescript": "^5.9.2",
    "vite": "8.2.2"
  },
  "bin": {
    "cordisx-chatroom": "./dist/agent-tools/cli/chatroom.mjs"
  }
}
