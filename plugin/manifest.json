{
  "$schema": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v5.schema.json",
  "schemaVersion": 5,
  "id": "org.cordisx.chatroom",
  "name": "Chatroom",
  "capabilities": [
    { "name": "agents.create", "required": true, "scope": {} },
    {
      "name": "agents.resume",
      "required": false,
      "scope": { "sessionIds": { "kind": "host-route-param", "routeId": "room-session-detail", "param": "sessionId" } }
    },
    {
      "name": "agents.get",
      "required": false,
      "scope": { "sessionIds": { "kind": "host-route-param", "routeId": "room-session-detail", "param": "sessionId" } }
    },
    {
      "name": "agents.message.submit",
      "required": false,
      "scope": { "sessionIds": { "kind": "host-route-param", "routeId": "room-session-detail", "param": "sessionId" } }
    },
    {
      "name": "agents.message.cancel",
      "required": false,
      "scope": { "sessionIds": { "kind": "host-route-param", "routeId": "room-session-detail", "param": "sessionId" } }
    },
    {
      "name": "agents.live.subscribe",
      "required": false,
      "scope": { "sessionIds": { "kind": "host-route-param", "routeId": "room-session-detail", "param": "sessionId" } }
    },
    {
      "name": "sessions.get",
      "required": false,
      "scope": { "sessionIds": { "kind": "host-route-param", "routeId": "room-session-detail", "param": "sessionId" } }
    },
    {
      "name": "sessions.read",
      "required": false,
      "scope": { "sessionIds": { "kind": "host-route-param", "routeId": "room-session-detail", "param": "sessionId" } }
    },
    {
      "name": "sessions.subscribe",
      "required": false,
      "scope": { "sessionIds": { "kind": "host-route-param", "routeId": "room-session-detail", "param": "sessionId" } }
    },
    {
      "name": "approvals.answer",
      "required": false,
      "scope": { "sessionIds": { "kind": "host-route-param", "routeId": "room-session-detail", "param": "sessionId" } }
    }
  ],
  "services": []
}
