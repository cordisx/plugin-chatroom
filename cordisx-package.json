{
  "$schema": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-package.v1.schema.json",
  "schemaVersion": 1,
  "id": "chatroom",
  "version": "0.1.0",
  "entry": "./src/chatroom.ts",
  "readme": "./README.md",
  "canonicalSource": "https://github.com/cordisx/plugin-chatroom",
  "compatibility": {
    "runtimeAbi": 1,
    "protocol": 1
  },
  "dependencies": [],
  "runtimeManifest": {
    "$schema": "https://raw.githubusercontent.com/cordisx/cordisx-protocol/main/schemas/plugin-manifest.v1.schema.json",
    "schemaVersion": 1,
    "id": "chatroom",
    "name": "Chatroom",
    "capabilities": [
      {
        "name": "tasks.create",
        "required": true,
        "reason": { "namespace": "chatroom", "key": "permission.tasks.create", "fallback": "Create a task for a new Room." },
        "scope": {}
      },
      {
        "name": "tasks.content.read",
        "required": true,
        "reason": { "namespace": "chatroom", "key": "permission.tasks.content.read", "fallback": "Read replies and task status for a Room." },
        "scope": {}
      },
      {
        "name": "turns.submit",
        "required": true,
        "reason": { "namespace": "chatroom", "key": "permission.turns.submit", "fallback": "Send Room messages to its Agent." },
        "scope": {}
      },
      {
        "name": "turns.introduce",
        "required": true,
        "reason": { "namespace": "chatroom", "key": "permission.turns.introduce", "fallback": "Ask a newly joined Agent to introduce itself." },
        "scope": {}
      },
      {
        "name": "approvals.decide",
        "required": true,
        "reason": { "namespace": "chatroom", "key": "permission.approvals.decide", "fallback": "Decide an Agent approval request from the Room." },
        "scope": {}
      }
    ]
  }
}
